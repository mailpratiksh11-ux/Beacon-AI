# Copy to .env and fill in your own values. NEVER commit the real .env.
NODE_ENV=development
PORT=5050

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Allowed CORS origins (comma-separated) + frontend origin for OAuth redirect-back
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# ---- Email sending ----
# Option A — Gmail App Password (needs 2-Step Verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B — generic SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Your Name <you@domain.com>"
# Option C — Google OAuth 2.0 (Gmail API). Redirect URI must match Google Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback

# Option D — Microsoft OAuth 2.0 (Graph). Sign in with Microsoft + read/send Outlook mail.
# Redirect URI must match the Azure app registration exactly. Tenant 'common' = personal + work/school.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5050/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# JWT signing secret — use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# Key for encrypting secrets at rest (falls back to JWT_SECRET if unset)
ENCRYPTION_KEY=

# Redis — caching + Socket.IO adapter + BullMQ queue (set empty to disable)
REDIS_URL=redis://127.0.0.1:6379

# ---- AI (OpenAI-compatible; default Groq — free Qwen3-32B) ----
# Free key at https://console.groq.com
AI_API_KEY=
AI_MODEL=qwen/qwen3-32b
AI_BASE_URL=https://api.groq.com/openai/v1
APP_URL=http://localhost:51378
