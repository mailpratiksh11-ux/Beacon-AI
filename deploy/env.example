# ---------------------------------------------------------------------------
# Beacon AI — production env for the Hostinger VPS.
# Copy to /opt/beacon/shared/.env on the server and fill in. Never commit it.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=5050

# ===========================================================================
# CARRY THESE TWO OVER FROM RENDER, UNCHANGED. THIS IS THE ONE STEP THAT
# SILENTLY DESTROYS DATA IF YOU GET IT WRONG.
#
# utils/crypto.js derives its AES key from sha256(ENCRYPTION_KEY || JWT_SECRET).
# Every stored mail password, Google/Microsoft refresh token and custom AI key
# in Atlas is encrypted under that key. Generate fresh values here and
# decryptSecret() returns '' with no error — every user silently falls back to
# the Ethereal test transport and their inbox breaks, with nothing in the logs.
#
# Note the fallback: if you never set ENCRYPTION_KEY on Render, then JWT_SECRET
# *is* the encryption key, and changing it is destructive rather than just a
# forced re-login.
# ===========================================================================
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=30d

# MongoDB Atlas — unchanged from Render. Add the VPS IP under Network Access.
MONGODB_URI=

# Redis runs on this box (see setup-vps.sh). Required for the send queue,
# resumable campaigns and the Socket.IO adapter.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379

# Same origin for app and API, so CORS is a non-issue. Use your real domain.
CORS_ORIGIN=https://beacon.example.com
FRONTEND_URL=https://beacon.example.com
APP_URL=https://beacon.example.com

# ---- Google OAuth -----------------------------------------------------------
# Must match the Authorised redirect URI in Google Cloud Console EXACTLY,
# trailing slash included.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://beacon.example.com/api/auth/google/callback

# ---- Microsoft OAuth (optional) ---------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://beacon.example.com/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# ---- System mail (password resets only; user campaigns use their own account)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# or generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- AI (Groq, OpenAI-compatible) -------------------------------------------
AI_API_KEY=
AI_MODEL=qwen/qwen3-32b
AI_BASE_URL=https://api.groq.com/openai/v1
